# Database (pooled URL for serverless — Neon pooler or Supabase pgbouncer)
# Append ?pgbouncer=true&connection_limit=1 if the provider does not add them.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true&connection_limit=1"

# Unpooled URL used by Prisma Migrate (`prisma migrate deploy`).
# Aliases accepted: DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING
# (Neon / Vercel Postgres integrations). If omitted, DATABASE_URL is reused.
DIRECT_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Vercel Cron (set automatically on Vercel; needed for local cron testing)
CRON_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="SourceTool <noreply@sourcetool.io>"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google"

# Apple OAuth
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Rainforest API (Amazon product data)
RAINFOREST_API_KEY=""

# Amazon APIs
AMAZON_PA_API_ACCESS_KEY=""
AMAZON_PA_API_SECRET_KEY=""
AMAZON_PA_API_PARTNER_TAG=""
AMAZON_SP_API_CLIENT_ID=""
AMAZON_SP_API_CLIENT_SECRET=""
AMAZON_SP_API_REFRESH_TOKEN=""
SP_API_SANDBOX="true"

# Keepa
KEEPA_API_KEY=""

# Walmart
WALMART_CLIENT_ID=""
WALMART_CLIENT_SECRET=""

# eBay
EBAY_APP_ID=""
EBAY_CERT_ID=""
EBAY_DEV_ID=""

# AI
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Vercel AI Gateway (optional, OFF by default — only used when a caller
# explicitly passes provider: 'vercel' to scoreDeal/predictSellThrough).
# Defaults to the free `minimax/minimax-m3-free` model.
AI_GATEWAY_API_KEY=""

# App
# Leave NEXT_PUBLIC_API_URL unset (or set to "/api") so the dashboard calls same-origin routes.
# The Chrome extension still needs an absolute URL, e.g. https://app.sourcetool.io/api
NEXT_PUBLIC_API_URL="/api"
WEB_URL="http://localhost:3000"
NODE_ENV="development"
